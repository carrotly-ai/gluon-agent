# Gluon Agent — Environment Variables
# Copy to .env and fill in your values:
#   cp .env.example .env

# ─── Container User ─────────────────────────────────────────────
# Match these to your host user so bind-mounted volumes have correct ownership.
# Run: id -u  and  id -g  to find your values.
PUID=1000
PGID=1000

# ─── Required ───────────────────────────────────────────────────

# GitHub personal access token (for PR creation and HTTPS git auth)
GH_TOKEN=ghp_your_token_here

# Git author identity (used inside the container)
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# ─── LLM Provider ─────────────────────────────────────────────
# Choose ONE provider: "bedrock" (default), "anthropic", "vertex", or "foundry".
#
# Gluon automatically exports the matching CLAUDE_CODE_USE_* flag (plus any
# per-provider config you've filled in below) into the Claude Code subprocess,
# so you only need to set the lines for your chosen backend.
GLUON_LLM_PROVIDER=bedrock

# --- [1/4] AWS Bedrock (default) ---
# Required for `GLUON_LLM_PROVIDER=bedrock`
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# CLAUDE_CODE_USE_BEDROCK is set automatically by Gluon when provider=bedrock.
# You can override it here if you need to force the flag on/off.
# CLAUDE_CODE_USE_BEDROCK=1

# --- [2/4] Direct Anthropic API / Claude CLI subscription ---
# For `GLUON_LLM_PROVIDER=anthropic`
# GLUON_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# (Or authenticate via: claude login — no API key needed)

# --- [3/4] Google Vertex AI ---
# For `GLUON_LLM_PROVIDER=vertex`
# GLUON_LLM_PROVIDER=vertex
# ANTHROPIC_VERTEX_PROJECT_ID=my-gcp-project
# CLOUD_ML_REGION=global   # or: us, eu, us-east5, europe-west1, etc.
#
# Auth: Application Default Credentials. On the host run:
#   gcloud auth application-default login
# (The docker-compose mounts ~/.config/gcloud read-only into the container.)
# Or point at a service-account key file:
# GOOGLE_APPLICATION_CREDENTIALS=/home/gluon/.config/gcloud/sa-key.json

# --- [4/4] Microsoft Foundry (Azure AI Foundry) ---
# For `GLUON_LLM_PROVIDER=foundry`
# GLUON_LLM_PROVIDER=foundry
# ANTHROPIC_FOUNDRY_RESOURCE=my-azure-resource
# # ONE of: API key OR Entra ID (recommended — uses `az login` / managed identity)
# ANTHROPIC_FOUNDRY_API_KEY=...
# # (If unset, the Azure default credential chain is used.)
# # Alternative: provide the full base URL instead of a resource name
# # ANTHROPIC_FOUNDRY_BASE_URL=https://{resource}.services.ai.azure.com/anthropic

# --- Model pinning (works across all cloud providers) ---
# Claude Code recognises these env vars on all three cloud backends.
# Pin versions for multi-user deployments so a newer model doesn't surprise you.
# ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-7
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
# ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5

# ─── Optional: Chat Bots ────────────────────────────────────────

# Telegram bot
# GLUON_TELEGRAM_TOKEN=your-telegram-bot-token
# GLUON_TELEGRAM_USERS=123456789  # Comma-separated allowed user IDs

# Discord bot
# GLUON_DISCORD_TOKEN=your-discord-bot-token
# GLUON_DISCORD_GUILD=your-guild-id
# GLUON_DISCORD_USERS=  # Comma-separated allowed user IDs

# ─── Optional: HTTPS ────────────────────────────────────────────

# Set both to enable HTTPS for the web dashboard
# GLUON_SSL_CERTFILE=/home/gluon/.gluon/ssl/cert.crt
# GLUON_SSL_KEYFILE=/home/gluon/.gluon/ssl/key.key

# ─── Optional: Integrations ─────────────────────────────────────

# Vercel API token (for deployment management)
# VERCEL_TOKEN=
